# ============================================================
# 服务器部署最小配置模板（美股/港股 + 本机 PostgreSQL + 域名）
# ============================================================
# 用法：
#   cp docker/env.server.example .env
#   vim .env
#   python scripts/check_server_env.py      # 启动前先跑一遍，确认没有漏填/填错
#   docker compose -f docker/docker-compose.server.yml up -d --build
#
# 重要：
#   1) 分容器部署时 SCHEDULE_ENABLED 必须为 false。
#      - server 容器用 `--serve-only` 提供 Web/API
#      - analyzer 容器用 `--schedule` 执行每日分析
#      若这里设为 true，server 容器会进入定时模式而不提供网页。
#   2) 不要把 5432 / 8000 暴露到公网；Web 只通过 Caddy 的 443 访问。
# ============================================================

# ---------- 基础 ----------
# 服务器系统时区（analyzer 容器会单独用 America/New_York）
TZ=Asia/Shanghai
LOG_LEVEL=INFO

# 自选股：只放美股/港股
STOCK_LIST=AAPL,MSFT,NVDA,0700

# 大盘复盘：设 us / hk / hk+us / all；设为 false 可先关闭以缩短首轮时间
MARKET_REVIEW_ENABLED=false
MARKET_REVIEW_REGION=us

# Gemini 免费档建议 1，避免并发触发 429
MAX_WORKERS=1

# ---------- 数据库 ----------
# 默认由 docker/docker-compose.db.yml 单独运行 PostgreSQL（不占用宿主机 5432）
# 密码生成：openssl rand -hex 16（只用十六进制，避免 URL 转义问题）
POSTGRES_DB=dsa
POSTGRES_USER=dsa
POSTGRES_PASSWORD=CHANGE_ME
# 主机名固定写 db：应用栈与数据库栈通过外部网络 dsa-net 互通
# 密码必须与 POSTGRES_PASSWORD 完全一致
DATABASE_URL=postgresql+psycopg2://dsa:CHANGE_ME@db:5432/dsa
# 改用宿主机已有的 PostgreSQL：主机名换成 host.docker.internal，
# 并按 docs/DEPLOY.md 配置 listen_addresses + pg_hba.conf（放行 172.16.0.0/12）
# DATABASE_URL=postgresql+psycopg2://dsa:CHANGE_ME@host.docker.internal:5432/dsa
# 非 Docker 直接运行：主机名换成 127.0.0.1

# ---------- LLM ----------
LITELLM_MODEL=gemini/gemini-3-flash-preview
GEMINI_API_KEY=CHANGE_ME
# 多 Key 轮询（与 Actions 的 GEMINI_API_KEYS 对应）：
# GEMINI_API_KEYS=key1,key2
LITELLM_FALLBACK_MODELS=gemini/gemini-2.5-flash
LLM_TEMPERATURE=0.3
# 免费档约 10 RPM：7 秒间隔 + 2 次重试
GEMINI_REQUEST_DELAY=7
GEMINI_MAX_RETRIES=2
# LiteLLM 默认会打大量 DEBUG（路由/重试/部署列表），把真正的业务错误淹掉
LITELLM_LOG=ERROR
# Actions 里的 GEMINI_MODEL / GEMINI_MODEL_FALLBACK 只在未设置 LITELLM_MODEL 时生效；
# 这里统一用 LITELLM_MODEL / LITELLM_FALLBACK_MODELS，避免两套配置打架。

# Agent 模式：Actions 里是 AGENT_MODE=true。标准分析链（含最新的提示词/日期/regime 修复）
# 建议先用 false；确实依赖 skills 再开启。
AGENT_MODE=false
AGENT_ARCH=single
AGENT_SKILLS=

# ---------- 行情 / 新闻 ----------
ENABLE_REALTIME_QUOTE=true
# 美股/港股不需要 A 股的全市场预取
PREFETCH_REALTIME_QUOTES=false
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# 搜索源：只填有效的 Key；失效的 Key 会拖慢整轮分析
TAVILY_API_KEYS=
# BOCHA_API_KEYS=
# BRAVE_API_KEYS=
# SERPAPI_API_KEYS=
# XAI_API_KEYS=
NEWS_RSS_ENABLED=true
NEWS_MAX_AGE_DAYS=3

# 社交情绪（可选，Actions 里的 SOCIAL_SENTIMENT_API_KEY）
# SOCIAL_SENTIMENT_API_KEY=
# SOCIAL_SENTIMENT_API_URL=https://api.adanos.org

# TickFlow 只用于 A 股大盘复盘/指数；美股/港股可以留空
# TICKFLOW_API_KEY=

# ---------- 基本面 / 筹码 ----------
ENABLE_FUNDAMENTAL_PIPELINE=true
# 美股走 SEC，1.5 秒经常不够
FUNDAMENTAL_STAGE_TIMEOUT_SECONDS=5
# 美股/港股没有筹码分布
ENABLE_CHIP_DISTRIBUTION=false

# ---------- 分析 ----------
ANALYSIS_HISTORY_DAYS=60
# 最新日线落后目标交易日超过 7 天：先强制刷新，仍过期则停止分析
ANALYSIS_MAX_STALENESS_DAYS=7
REPORT_TYPE=simple
REPORT_LANGUAGE=zh
REPORT_SUMMARY_ONLY=false
# Actions 里是 ANALYSIS_DELAY=15；每题 15 秒会显著拉长总时长，服务器建议 0–2
ANALYSIS_DELAY=0
TRADING_DAY_CHECK_ENABLED=true

# ---------- 回测 ----------
BACKTEST_ENABLED=true
BACKTEST_EVAL_WINDOW_DAYS=10
# 首轮先用单窗口，稳定后再改回 1,5,20
BACKTEST_EXTRA_WINDOWS=10
BACKTEST_MIN_AGE_DAYS=14
BACKTEST_ENTRY_MODE=next_open
BACKTEST_NEUTRAL_BAND_PCT=2.0
BACKTEST_COMMISSION_BPS=0
BACKTEST_SLIPPAGE_BPS=5
BACKTEST_BENCHMARK_ENABLED=true
BACKTEST_BENCHMARK_US=SPY
BACKTEST_BENCHMARK_HK=2800.HK
BACKTEST_BENCHMARK_CN=510300.SS

# 学习/回测初期先限制规模，避免拖慢每日分析
ANALYSIS_LEARNING_MIN_SAMPLES=20
ANALYSIS_LEARNING_AUTO_BACKTEST_LIMIT=50
ANALYSIS_LEARNING_MODEL_TRAIN_MIN_SAMPLES=60

# ---------- 调度 ----------
# 分容器部署必须 false（见文件头说明）
SCHEDULE_ENABLED=false
# analyzer 容器使用 America/New_York，这里的 10:00 即 10:00 ET
SCHEDULE_TIME=10:00
# 首次部署想立刻跑一轮可改 true；正常后建议 false
SCHEDULE_RUN_IMMEDIATELY=false
# 只影响"起 Web 且常驻"的进程是否跳过启动即分析；
# analyzer 容器里裸跑 main.py（一次性命令）不受它影响，仍会正常执行分析
RUN_IMMEDIATELY=false

# ---------- Web / 认证 ----------
WEBUI_ENABLED=true
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8000
# Docker 宿主机映射端口（Caddy 反代到 127.0.0.1:8000）
API_PORT=8000
WEBUI_AUTO_BUILD=true
ADMIN_AUTH_ENABLED=true

# ---------- 通知（至少配置一个）----------
# 注意：DINGTALK_APP_KEY/SECRET 只用于 Stream 模式回复对话，不会推送日报。
# 想用钉钉收日报，把群机器人 webhook 填到 CUSTOM_WEBHOOK_URLS：
#   CUSTOM_WEBHOOK_URLS=https://oapi.dingtalk.com/robot/send?access_token=...
# WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/...
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...
# EMAIL_SENDER=
# EMAIL_PASSWORD=
# CUSTOM_WEBHOOK_URLS=
